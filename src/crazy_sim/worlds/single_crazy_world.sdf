<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="single_cf_world">

    <!-- Physics -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Gazebo core systems -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>

    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Sun light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane (grey background) -->
    <model name="ground_plane">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>4 4</size>
            </plane>
          </geometry>

          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <!-- ============================================================ -->
    <!-- Heatmap on ground - 2m x 2m centered at (1, 1, 0)            -->
    <!-- Arena: x=[0,2], y=[0,2]                                      -->
    <!-- ============================================================ -->
    <!-- <model name="heatmap_ground">
      <static>true</static>
      <pose>1 1 0.001 0 0 0</pose>
      <link name="link">
        <visual name="heatmap_visual">
          <geometry>
            <box>
              <size>2 2 0.001</size>
            </box>
          </geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <specular>0 0 0 1</specular>
            <pbr>
              <metal>
                <albedo_map>materials/textures/heatmap.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>1.0</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>-->

    <!-- ============================================================ -->
    <!-- Overhead Camera - fixed at (1, 1, 3) looking straight down   -->
    <!-- Covers 2m x 2m arena from 3m height                         -->
    <!-- ============================================================ -->
    <model name="overhead_camera">
      <static>true</static>
      <pose>1 1 3 0 1.5708 0</pose>
      <link name="camera_link">
        <visual name="visual">
          <geometry>
            <box><size>0.05 0.05 0.05</size></box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
        <sensor name="overhead_cam" type="camera">
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <topic>/overhead_camera/image</topic>
          <camera>
            <horizontal_fov>0.7854</horizontal_fov>
            <image>
              <width>512</width>
              <height>512</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>10</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- Single Crazyflie -->
    <include>
      <uri>model://cf0</uri>
      <name>cf0</name>
      <pose>0 0 0.05 0 0 0</pose>
    </include>

  </world>
</sdf>
